              ],
              [
                {
                  "content": [
                    {
                      "text": "Mr. Bennet",
                      "type": "text"
                    }
                  ],
                  "rowspan": 2
                },
                {
                  "content": [
                    {
                      "text": "“I hope Mr. Bingley will like it Lizzy.”",
                      "type": "text"
                    }
                  ]
                }
              ],
              [
                {
                  "content": [
                    {
                      "text": "“No more have I,” said Mr. Bennet; “and I am glad to find that you do not depend on her serving you.”",
                      "type": "text"
                    }
                  ]
                }
              ],
              [
                {
                  "content": [
                    {
                      "text": "Mrs. Bennet",
                      "type": "text"
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "text": "“Don’t keep coughing so, Kitty, for heaven’s sake!”",
                      "type": "text"
                    }
                  ]
                }
              ]
            ],
            "type": "table"
          },
          {
            "content": [
              {
